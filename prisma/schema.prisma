datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invitations   Invitation[]
  subscriptions Subscription[]
}

model Template {
  id           String        @id
  name         String
  category     String
  description  String
  previewImage String?
  priceTier    String        @default("FREE") // "FREE" | "PREMIUM"
  active       Boolean       @default(true)
  invitations  Invitation[]
  createdAt    DateTime      @default(now())
}

model Invitation {
  id                String    @id @default(uuid())
  publicSlug        String    @unique
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  templateId        String
  template          Template  @relation(fields: [templateId], references: [id])
  groomName         String
  brideName         String
  groomParents      String?
  brideParents      String?
  weddingDate       String    // YYYY-MM-DD
  weddingTime       String    // HH:mm
  venueName         String
  venueAddress      String
  mapUrl            String?
  invitationMessage String?
  musicUrl          String?
  dressCode         String?
  coverTitle        String?
  programJson       String?   // JSON array of timeline events
  themeSettings     String?   // JSON object
  status            String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  rsvps             RSVP[]

  @@index([publicSlug])
  @@index([ownerId])
  @@index([templateId])
}

model RSVP {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName    String
  attendance   String     // "ATTENDING" | "NOT_ATTENDING"
  guestCount   Int        @default(1)
  note         String?
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("FREE") // "FREE" | "PREMIUM" | "VIP"
  status    String   @default("ACTIVE") // "ACTIVE" | "EXPIRED"
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
